{
    "swagger": "2.0",
    "info": {
        "title": "Code Verification API",
        "description": "# Documentation",
        "version": "1.0.0"
    },
    "basePath": "/api",
    "schemes": [
        "http"
    ],
    "paths": {
        "/check-code": {
            "post": {
                "summary": "Check code validity",
                "description": "Checks the validity of a code",
                "tags": [
                    "order"
                ],
                "produces": [
                    "application/json"
                ],
                "parameters": [
                    {
                        "in": "header",
                        "name": "Authorization",
                        "description": "API Key for authentication",
                        "required": true,
                        "type": "string"
                    },
                    {
                        "in": "body",
                        "name": "codeDetails",
                        "description": "Code information",
                        "required": true,
                        "schema": {
                            "type": "object",
                            "properties": {
                                "code_number": {
                                    "type": "string",
                                    "description": "Code number"
                                },
                                "month": {
                                    "type": "string",
                                    "example": "10",
                                    "description": "Month number"
                                },
                                "last_code": {
                                    "type": "string",
                                    "description": "Last four digit code"
                                }
                            }
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Order ID (pending for check)",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "order_id": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/check-status/{order_id}": {
            "get": {
                "summary": "Check code validity",
                "description": "Checks the validity of a code",
                "tags": [
                    "order"
                ],
                "produces": [
                    "application/json"
                ],
                "parameters": [
                    {
                        "in": "header",
                        "name": "Authorization",
                        "description": "API Key for authentication",
                        "required": true,
                        "type": "string"
                    },
                    {
                        "in": "path",
                        "name": "order_id",
                        "description": "Order identifier",
                        "required": true,
                        "minimum": 1,
                        "type": "string"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Result of checking",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "state": {
                                    "type": "string",
                                    "required": true,
                                    "enum": [
                                        "error",
                                        "valid",
                                        "fail",
                                        "null"
                                    ]
                                },
                                "code_error": {
                                    "type": "string"
                                },
                                "zip_is_correct": {
                                    "type": "boolean",
                                    "nullable": true,
                                    "example": false
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/get-limit": {
            "get": {
                "summary": "Get limit info",
                "description": "Get limit info",
                "tags": [
                    "order"
                ],
                "produces": [
                    "application/json"
                ],
                "parameters": [
                    {
                        "in": "header",
                        "name": "Authorization",
                        "description": "API Key for authentication",
                        "required": true,
                        "type": "string"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "pending": {
                                    "type": "integer"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/account-info": {
            "get": {
                "summary": "Get account info",
                "description": "Get account info",
                "tags": [
                    "account"
                ],
                "produces": [
                    "application/json"
                ],
                "parameters": [
                    {
                        "in": "header",
                        "name": "Authorization",
                        "description": "API Key for authentication",
                        "required": true,
                        "type": "string"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "balance": {
                                    "type": "number",
                                    "format": "float"
                                },
                                "price": {
                                    "type": "number",
                                    "format": "float"
                                },
                                "wallets": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/WalletModel"
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "WalletModel": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "network": {
                        "type": "string"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "address": {
                        "type": "string"
                    }
                }
            }
        }
    }
}