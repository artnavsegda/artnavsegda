# Базовые URL контрактов. Можно указать абсолютный адрес (как ниже) — тогда фронт
# стучится в бэкенд прямо из браузера, без dev-proxy и без reverse-proxy в проде.
VITE_ORDER_API_BASE=http://45.129.126.13:4287/api
# VITE_AUTH_API_BASE=http://<host>:<port>/api/v1

# Альтернатива — проксировать через Vite в деве (если нужен относительный путь
# из-за CORS или смешанного контента http/https):
# VITE_AUTH_PROXY_TARGET=http://localhost:8080
# VITE_ORDER_PROXY_TARGET=http://localhost:8081
